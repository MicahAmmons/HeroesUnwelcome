<Project>
  <!--
    Every NuGet package version used anywhere in the solution, pinned to an
    exact number. Upgrading a package is a deliberate one-line change here,
    never a surprise from a floating "3.8.*" version.
  -->
  <ItemGroup>
    <!-- MonoGame (keep in sync with .config/dotnet-tools.json) -->
    <PackageVersion Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
    <PackageVersion Include="MonoGame.Content.Builder.Task" Version="3.8.5.1" />

    <!-- Developer tools (debug builds only) -->
    <PackageVersion Include="ImGui.NET" Version="1.91.6.1" />

    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
</Project>
