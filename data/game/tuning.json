{
  // Every simulation number that isn't about a specific room.
  // Durations are in game beats (at 1x speed, 100 bpm: 1 beat = 0.6 s).
  "hallwayBeats": 4,
  "portalBeats": 3,
  "respawnBeats": 32,

  // The encounter choreography. Each step has a fixed length, and the party
  // and the encounter act in lockstep through them:
  //   arrive pause -> banner down (order swaps when fully covered) -> banner hold -> banner up ->
  //   entrance (front hero to the hero spot) -> ready (face-off) -> action (dice rolled at its end) ->
  //   result (victory/death + reactions) -> recover ->
  //   step up (after a death; then ready again)  or  catch up (after a win; then walk on)
  "arrivePauseBeats": 1,
  "bannerDownBeats": 1,
  "bannerHoldBeats": 2,
  "bannerUpBeats": 1,
  "entranceBeats": 2,
  "readyBeats": 1,
  "actionBeats": 2,
  "resultBeats": 2,
  "recoverBeats": 1,
  "stepUpBeats": 2,
  "catchUpBeats": 2,

  // Debugging: extra stillness after every step (0 = off). Try 2 to check timing by eye.
  "debugGapBeats": 0,

  // Success chance = 1 / (1 + e^(-(skill - difficulty) / steepness)).
  // Equal skill and difficulty = 50%. Smaller steepness = less luck.
  "challengeSteepness": 0.8,

  // Growth: skill gained in a room's category after an attempt (heroes learn most from dying).
  "skillOnWin": 0.05,
  "skillOnLoss": 0.3,

  // Rust: once a hero hasn't attempted a category for this many beats, that skill
  // drops by skillRustPerBeat each beat (never below their starting value).
  // Only the listed categories rust (Boss is only practised at the treasure room).
  // SimRunner comparison (200 runs): 120/0.005 → heroes won 17/200; 200/0.002 → 191/200,
  // ~7 classes earned and ~4 lost per run; no rust → 200/200, nothing ever lost.
  "skillRustGraceBeats": 200,
  "skillRustPerBeat": 0.002,
  "skillRustCategories": ["Combat", "Trap"],

  // "reputation" ordering rule: reputation change per result.
  "reputationOnWin": 1.0,
  "reputationOnLoss": 0.5,

  // "auto" spawn rule: the newest party must be this many rooms in before the next enters.
  "spawnGapRooms": 2
}
