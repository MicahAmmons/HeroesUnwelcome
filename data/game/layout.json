{
  // Where things stand inside a room, as a fraction of the cell's width measured
  // along the direction of travel: 0 = the side heroes enter from, 1 = the side they leave by.
  // The travel half is 0-0.5 and the encounter half 0.5-1; the border (and hallway door) is at 0.5.
  "default": {
    "lineFront": 0.44,     // front of the waiting line: just before the border
    "heroSpot": 0.667,     // where the front hero faces the encounter (1/3 into the encounter half)
    "encounter": 0.833,    // the monster or trap (2/3 into the encounter half)
    "door": 0.5,           // the hallway door, on the border
    "entryPortal": 0.05,   // where heroes come out of a portal (far enough back for a line of 4 to fit before the border)
    "exitPortal": 0.94     // where heroes step into a portal
  },

  // Distance between heroes in the line (fraction of cell width; 0.125 = 240 world units, a little more than a hero is wide).
  "spacing": 0.125,

  // Which hero animation is the "action" for each room category.
  "actionClips": { "Combat": "Fight", "Trap": "Disarm", "Boss": "Fight" },

  // Per room kind overrides of any "default" value.
  "rooms": {
    "PitFall": { "heroSpot": 0.62 },
    "LichLord": { "heroSpot": 0.64, "encounter": 0.85 }
  }
}
