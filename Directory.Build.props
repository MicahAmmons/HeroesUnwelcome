<Project>
  <!--
    Settings shared by every project in the solution. MSBuild automatically
    imports this file into any project below this folder, so individual
    .csproj files only need to say what makes them different.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <!-- Package versions live in Directory.Packages.props, not in each project. -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
