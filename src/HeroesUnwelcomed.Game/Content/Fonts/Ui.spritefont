<?xml version="1.0" encoding="utf-8"?>
<!--
  Development UI font. Uses Windows' Arial, which is fine for placeholders but
  will be replaced by a properly licensed font with the final art.
-->
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>Arial</FontName>
    <Size>32</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    <DefaultCharacter>?</DefaultCharacter>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
      <!-- Latin-1: accented letters, ·, ×, °, etc. -->
      <CharacterRegion>
        <Start>&#160;</Start>
        <End>&#255;</End>
      </CharacterRegion>
      <!-- Bullet -->
      <CharacterRegion>
        <Start>&#8226;</Start>
        <End>&#8226;</End>
      </CharacterRegion>
      <!-- Ellipsis -->
      <CharacterRegion>
        <Start>&#8230;</Start>
        <End>&#8230;</End>
      </CharacterRegion>
      <!-- Arrows ← ↑ → ↓ -->
      <CharacterRegion>
        <Start>&#8592;</Start>
        <End>&#8595;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
